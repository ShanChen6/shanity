# Copy to .env at repository root; replace the password before starting.
PGHOST=localhost
PGPORT=5432
PGUSER=shanity
PGPASSWORD=replace-with-your-local-password
PGDATABASE=shanity
API_PORT=4000
WEB_PORT=3000

# Bootstrap the initial account with the existing admin permissions.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# Local Compose only. Set production behind HTTPS in deployments.
API_NODE_ENV=development
# Generate with: openssl rand -hex 32; required for API startup.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_SECONDS=900
AUTH_REFRESH_SECONDS=2592000
# Exact frontend origin; HTTPS required when NODE_ENV=production.
WEB_ORIGIN=http://localhost:3000
# Optional locally: leave ALL three empty to disable Google routes (503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Public browser-facing API origin, embedded at frontend build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public origin of the web app (no path), for sitemap.xml, robots.txt, canonical
# links, Open Graph and JSON-LD. Set it in production or they point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Cloud authorized redirect URI: http://localhost:4000/auth/google/callback
# Backend redirects results to WEB_ORIGIN/auth/callback (no tokens in URL).

# Optional server-only origin for Next route guards (Compose sets http://api:4000).
# API_INTERNAL_URL=http://localhost:4000
# Host-only auth cookies require web and public API to share the same hostname.

# API local storage; relative to API working directory. Compose uses a named volume.
# AVATAR_STORAGE_DIR=uploads/avatars

# Private Lesson media storage. Keep this separate from AVATAR_STORAGE_DIR.
STORAGE_DRIVER=local
# Maximum accepted video upload size in MiB (1-2048).
MAX_VIDEO_SIZE_MB=2048
# LESSON_MEDIA_STORAGE_DIR=uploads/lessons
# Independent HMAC key for local signed URLs; generate with: openssl rand -hex 32
# MEDIA_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Dynamic VietQR and authenticated bank-forwarder webhook
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
# Display name of the bank shown next to the account number (defaults to VIETQR_BANK_ID)
# VIETQR_BANK_NAME=MB Bank
BANK_WEBHOOK_API_KEY=replace-with-a-long-random-secret
# Optional: QR image service, "vietqr" (img.vietqr.io, default) or "sepay" (qr.sepay.vn)
# VIETQR_QR_FORMAT=vietqr
# Optional: also require x-signature = HMAC-SHA256(secret, raw body) on bank webhooks
# BANK_WEBHOOK_HMAC_SECRET=replace-with-a-long-random-secret
# Stripe Checkout (leave empty to keep Stripe unavailable). Webhook endpoint:
# POST /payments/webhook/stripe, events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Web app: support address for the "Liên hệ hỗ trợ" button on failed orders (optional)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Cloudinary for essay attachments (signed direct uploads from the browser).
# Leave empty to disable uploads (the signature endpoint answers 503).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pusher Channels for real-time course chat (the API holds no sockets, so it
# runs on serverless hosts). Leave empty to disable: POST /api/v1/chat/auth
# then answers 503. Keep "Client events" disabled in the Pusher app settings:
# messages must go through the API, where they are checked and moderated.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# Web app: the same app's public key and cluster (never the secret). Without
# them the chat room works by polling and shows "Mất kết nối".
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=

# Blog comment moderation (layer 2: AI toxicity). openai (default; free,
# multilingual incl. Vietnamese) or perspective (free; check that it supports
# Vietnamese before choosing it). Without a key every comment that passes the
# local rules waits for an admin: nothing is ever approved unscored.
COMMENT_MODERATION_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODERATION_MODEL=omni-moderation-latest
# PERSPECTIVE_API_KEY=
# Extra hosts whose links are allowed in comments (comma-separated); the site
# itself and common docs (MDN, GitHub, ...) already are.
# COMMENT_LINK_ALLOWLIST=docs.shanity.vn
# Extra blocked terms (comma-separated), e.g. your political/brand policy.
# COMMENT_BLOCKLIST=

# Live classes embed YouTube, Vimeo and meet.jit.si out of the box. Anything
# else is refused unless listed here (comma-separated hosts, https only).
# Set the API and the web values to the same lists.
# LIVE_JITSI_HOSTS=jitsi.example.vn
# LIVE_EMBED_ALLOWED_HOSTS=stream.example.vn
# NEXT_PUBLIC_LIVE_JITSI_HOSTS=jitsi.example.vn
# NEXT_PUBLIC_LIVE_EMBED_ALLOWED_HOSTS=stream.example.vn

# Logging: pino through the Nest logger, one JSON object per line on stdout (pipe
# to pino-pretty locally if you want colours). One of
# fatal|error|warn|info|debug|trace|silent; default info (silent under NODE_ENV=test).
# Every line written during a request carries its correlation id (X-Correlation-Id).
# LOG_LEVEL=info

# Optional Redis for the public-catalog cache (browse, detail, syllabus). Leave
# empty to use a bounded in-process cache; a Redis outage only costs cache hits,
# never availability. With Compose: COMPOSE_PROFILES=cache and REDIS_URL=redis://redis:6379
# REDIS_URL=
# Seconds a public-catalog read may be served from cache (0-3600; 0 disables).
# Curriculum changes invalidate it immediately; this only bounds staleness.
# CACHE_PUBLIC_CATALOG_SECONDS=60

# Demo accounts for local development: `pnpm --filter api seed:demo` creates
# admin/instructor/student/finance@shanity.local plus a sample course and quiz.
# It refuses to run when NODE_ENV=production. Default password: Shanity-Demo-2026!
# SEED_DEMO_PASSWORD=

# Web footer (all optional; empty values hide the item). Only https URLs are used.
# Next inlines NEXT_PUBLIC_* at build time: set them before `docker compose build`
# (they are build args) or before `pnpm --filter web build`.
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
# NEXT_PUBLIC_SOCIAL_YOUTUBE=
# NEXT_PUBLIC_SOCIAL_TIKTOK=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_SOCIAL_GITHUB=
# Operator name and address shown in the footer's copyright line (default: brand name).
# NEXT_PUBLIC_LEGAL_ENTITY=
# NEXT_PUBLIC_LEGAL_ADDRESS=

# Retiring the old unprefixed API routes (everything that has an /api/v1/<domain>
# alias). They already answer with `Deprecation`, `Link: <new url>; rel="successor-version"`
# and, once a sunset is set, `Sunset`. Routes that never move (/auth, /health,
# signed media) are unaffected.
# LEGACY_ROUTES_DEPRECATED_SINCE=2026-10-09T00:00:00Z
# From this instant the old routes answer 410 Gone with the new location. Leave
# empty until the logs ("LegacyRoute" warnings, once per route per process) show
# no remaining callers. Must be later than the deprecation date; a malformed
# value stops the API at startup.
# LEGACY_ROUTES_SUNSET=
